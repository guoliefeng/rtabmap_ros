<?xml version="1.0"?>
<launch>
  <!-- Yangpu defaults are based on the static bag interface report. -->
  <arg name="cloud_topic" default="/lidar_preprocessor/meta_cloud"/>
  <arg name="imu_topic" default="/ins_driver/imu"/>
  <arg name="cloud_frame" default="base_link"/>
  <arg name="imu_frame" default="chcnav_msg_parser"/>

  <arg name="base_frame" default="base_link"/>
  <arg name="odom_frame" default="odom_rtabmap"/>
  <arg name="map_frame" default="map"/>

  <arg name="output_dir" default="$(env HOME)/dataDisk/hainan/yangpu/qc/rtabmap_output"/>
  <arg name="database_path" default="$(arg output_dir)/rtabmap.db"/>
  <arg name="delete_db_on_start" default="false"/>
  <arg name="rtabmap_args" default=""/>

  <arg name="use_sim_time" default="false"/>
  <param if="$(arg use_sim_time)" name="use_sim_time" value="true"/>

  <arg name="wait_imu_to_init" default="true"/>
  <arg name="deskewing" default="false"/>
  <arg name="deskewing_slerp" default="false"/>
  <arg name="scan_voxel_size" default="0.20"/>
  <arg name="scan_normal_k" default="20"/>
  <arg name="scan_range_min" default="2.0"/>
  <arg name="scan_range_max" default="100.0"/>
  <arg name="max_update_rate" default="0.0"/>
  <arg name="point_to_plane" default="true"/>
  <arg name="icp_iterations" default="30"/>
  <arg name="icp_max_correspondence_distance" default="1.0"/>
  <arg name="icp_correspondence_ratio" default="0.10"/>
  <arg name="rtabmap_detection_rate" default="2.0"/>

  <arg name="rtabmap_viz" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_config" default="$(find rtabmap_bringup)/rviz/mapping.rviz"/>
  <arg name="check_tf" default="true"/>
  <arg name="tf_check_timeout" default="30.0"/>
  <arg name="strict_tf_check" default="false"/>

  <arg name="delete_db_arg"
       default="$(eval delete_db_on_start and '--delete_db_on_start' or '')"/>

  <node if="$(arg check_tf)"
        pkg="rtabmap_bringup"
        type="check_tf.py"
        name="tf_preflight"
        output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="cloud_frame" value="$(arg cloud_frame)"/>
    <param name="imu_frame" value="$(arg imu_frame)"/>
    <param name="timeout" value="$(arg tf_check_timeout)"/>
    <param name="strict" value="$(arg strict_tf_check)"/>
  </node>

  <group ns="rtabmap">
    <node pkg="rtabmap_odom"
          type="icp_odometry"
          name="icp_odometry"
          output="screen">
      <rosparam command="load" file="$(find rtabmap_bringup)/config/icp_odometry.yaml"/>
      <param name="frame_id" type="string" value="$(arg base_frame)"/>
      <param name="odom_frame_id" type="string" value="$(arg odom_frame)"/>
      <param name="wait_imu_to_init" type="bool" value="$(arg wait_imu_to_init)"/>
      <param name="deskewing" type="bool" value="$(arg deskewing)"/>
      <param name="deskewing_slerp" type="bool" value="$(arg deskewing_slerp)"/>
      <param name="scan_voxel_size" type="double" value="$(arg scan_voxel_size)"/>
      <param name="scan_normal_k" type="int" value="$(arg scan_normal_k)"/>
      <param name="scan_range_min" type="double" value="$(arg scan_range_min)"/>
      <param name="scan_range_max" type="double" value="$(arg scan_range_max)"/>
      <param name="max_update_rate" type="double" value="$(arg max_update_rate)"/>
      <param name="Icp/PointToPlane" type="bool" value="$(arg point_to_plane)"/>
      <param name="Icp/Iterations" type="int" value="$(arg icp_iterations)"/>
      <param name="Icp/MaxCorrespondenceDistance" type="double" value="$(arg icp_max_correspondence_distance)"/>
      <param name="Icp/CorrespondenceRatio" type="double" value="$(arg icp_correspondence_ratio)"/>

      <remap from="scan" to="/unused_scan"/>
      <remap from="scan_cloud" to="$(arg cloud_topic)"/>
      <remap from="imu" to="$(arg imu_topic)"/>
      <remap from="odom" to="/rtabmap/odom"/>
    </node>

    <node pkg="rtabmap_slam"
          type="rtabmap"
          name="rtabmap"
          output="screen"
          args="$(arg delete_db_arg) $(arg rtabmap_args)">
      <rosparam command="load" file="$(find rtabmap_bringup)/config/rtabmap_mapping.yaml"/>
      <param name="database_path" type="string" value="$(arg database_path)"/>
      <param name="frame_id" type="string" value="$(arg base_frame)"/>
      <param name="map_frame_id" type="string" value="$(arg map_frame)"/>
      <param name="odom_frame_id" type="string" value=""/>
      <param name="subscribe_depth" type="bool" value="false"/>
      <param name="subscribe_rgb" type="bool" value="false"/>
      <param name="subscribe_rgbd" type="bool" value="false"/>
      <param name="subscribe_stereo" type="bool" value="false"/>
      <param name="subscribe_scan" type="bool" value="false"/>
      <param name="subscribe_scan_cloud" type="bool" value="true"/>
      <param name="subscribe_scan_descriptor" type="bool" value="false"/>
      <param name="subscribe_odom_info" type="bool" value="true"/>
      <param name="approx_sync" type="bool" value="false"/>
      <param name="topic_queue_size" type="int" value="10"/>
      <param name="sync_queue_size" type="int" value="100"/>
      <param name="wait_for_transform_duration" type="double" value="0.2"/>
      <param name="Rtabmap/DetectionRate" type="double" value="$(arg rtabmap_detection_rate)"/>

      <remap from="scan_cloud" to="/rtabmap/odom_filtered_input_scan"/>
      <remap from="odom" to="/rtabmap/odom"/>
      <remap from="odom_info" to="/rtabmap/odom_info"/>
      <remap from="imu" to="$(arg imu_topic)"/>
    </node>

    <node if="$(arg rtabmap_viz)"
          pkg="rtabmap_viz"
          type="rtabmap_viz"
          name="rtabmap_viz"
          output="screen">
      <param name="frame_id" type="string" value="$(arg base_frame)"/>
      <param name="subscribe_scan_cloud" type="bool" value="true"/>
      <param name="subscribe_odom_info" type="bool" value="true"/>
      <param name="wait_for_transform_duration" type="double" value="0.2"/>
      <remap from="scan_cloud" to="/rtabmap/odom_filtered_input_scan"/>
      <remap from="odom" to="/rtabmap/odom"/>
      <remap from="odom_info" to="/rtabmap/odom_info"/>
    </node>
  </group>

  <node if="$(arg rviz)"
        pkg="rviz"
        type="rviz"
        name="rviz"
        args="-d $(arg rviz_config)"
        output="screen"/>
</launch>
